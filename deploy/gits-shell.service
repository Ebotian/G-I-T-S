[Unit]
Description=G-I-T-S 通道（投递 outbox / 收消息）
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
Restart=always
RestartSec=2

# 实例的身份：非 root、不能登录
User=gits
Group=gits
WorkingDirectory=/srv/gits-runtime

EnvironmentFile=/etc/gits.env
ExecStart=/srv/gits-runtime/.venv/bin/python -m gits.cli \
    --db /var/lib/gits/gits.db shell \
    --weixin-state /var/lib/gits/weixin.json --node cloud

# 三层隔离的后两层：即使文件权限被改松，这一步也挡住。
# 实例跑的是 /srv/gits-runtime 里的一份代码拷贝，不需要仓库。
InaccessiblePaths=/srv/gits
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/gits

MemoryMax=150M
Nice=5

[Install]
WantedBy=multi-user.target
