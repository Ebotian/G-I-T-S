[Unit]
Description=G-I-T-S 通道（投递 outbox / 收消息）
Documentation=file:/srv/gits/docs/research/ecs.md
After=network-online.target gits-ghost.service
Wants=network-online.target gits-ghost.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
Restart=always
RestartSec=3

WorkingDirectory=/srv/gits
# 微信通道（iLink Bot）。游标存在 var/weixin.cursor.json——
# 服务端只给"新"消息，不存游标就等于丢消息。
ExecStart=/srv/gits/.venv/bin/python -m gits.cli --db /srv/gits/var/gits.db shell --weixin-state /srv/gits/var/weixin.json --node cloud

MemoryMax=150M
Nice=5

[Install]
WantedBy=multi-user.target
