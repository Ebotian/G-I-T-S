[Unit]
Description=G-I-T-S 通道（投递 outbox / 收消息）
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
Restart=always
RestartSec=3

# 只有主个体有对外通道——所以这个单元是 her 的，不是模板。
User=her
Group=gits
WorkingDirectory=/srv/gits-runtime

ExecStart=/srv/gits-runtime/.venv/bin/python -m gits.cli \
    --db /var/lib/gits/shared/gits.db shell \
    --out /var/lib/gits/shared/outbox.jsonl \
    --inbox /var/lib/gits/shared/inbox.jsonl \
    --weixin-state /var/lib/gits/her/weixin.json --node cloud

InaccessiblePaths=/srv/gits
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/gits/shared /var/lib/gits/her

MemoryMax=150M
Nice=5

[Install]
WantedBy=multi-user.target
