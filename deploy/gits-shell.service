[Unit]
Description=G-I-T-S 通道（投递 outbox / 收消息）
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
Restart=always
RestartSec=3

User=gits
Group=gits
# 工作目录是只读的运行目录：**所有写入都必须显式指向 /var/lib/gits**。
# 上一版忘了这一点，FileChannel 去建相对路径 var/ ，撞上 Read-only file system。
WorkingDirectory=/srv/gits-runtime

ExecStart=/srv/gits-runtime/.venv/bin/python -m gits.cli \
    --db /var/lib/gits/gits.db shell \
    --out /var/lib/gits/outbox.jsonl \
    --inbox /var/lib/gits/inbox.jsonl \
    --weixin-state /var/lib/gits/weixin.json --node cloud

InaccessiblePaths=/srv/gits
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/gits

MemoryMax=150M
Nice=5

[Install]
WantedBy=multi-user.target
