[Unit]
Description=G-I-T-S 夜间家务（恢复重放 + 一致性自检）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=her
Group=gits
WorkingDirectory=/srv/gits-runtime
InaccessiblePaths=/srv/gits
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# 备份要写盘：目录归 her，且必须在这里放行（ProtectSystem 会挡住）。
ReadWritePaths=/var/lib/gits/shared /var/lib/gits/her /var/backups/gits

# **在影子库上校验，不动线上库。**重放会清空 outbox / influence 这些投影表，
# 对正在用的库直接跑会丢掉尚未发出的回复（旧版还会让所有旧消息重新变成待回复，
# 于是重答、重发、重复付费）。真需要恢复时手工跑 replay --restore。
ExecStart=/srv/gits-runtime/.venv/bin/python -m gits.cli --db /var/lib/gits/shared/gits.db replay --shadow
# **备份是独立的一步，不是 replay 的副产品。**
# replay --shadow 校验的是"日志能不能重建投影"，库文件坏了它照样坏。
ExecStart=/srv/gits-runtime/.venv/bin/python -m gits.cli --db /var/lib/gits/shared/gits.db backup
ExecStartPost=/srv/gits-runtime/.venv/bin/python -m gits.cli --db /var/lib/gits/shared/gits.db status
Nice=10
IOSchedulingClass=idle
MemoryMax=400M
