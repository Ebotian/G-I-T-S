[Unit]
Description=G-I-T-S 夜间家务（恢复重放 + 一致性自检）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=her
Group=gits
WorkingDirectory=/srv/gits-runtime
InaccessiblePaths=/srv/gits
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/gits/shared /var/lib/gits/her

ExecStart=/srv/gits-runtime/.venv/bin/python -m gits.cli --db /var/lib/gits/shared/gits.db replay --restore
ExecStartPost=/srv/gits-runtime/.venv/bin/python -m gits.cli --db /var/lib/gits/shared/gits.db status
Nice=10
IOSchedulingClass=idle
MemoryMax=400M
