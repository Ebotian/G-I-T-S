[Unit]
Description=G-I-T-S 内核（心跳 / 回复 / 快照 / 整理）
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
Restart=always
RestartSec=2

# 每个实例一个用户，同一个组。
# 同组 = 能协作（共享库）；不同用户 = 哪个进程写了什么是确定的。
User=her
Group=gits

# 工作目录是只读的运行目录：所有写入都必须显式指到 /var/lib/gits。
WorkingDirectory=/srv/gits-runtime

EnvironmentFile=/etc/gits.env
ExecStart=/srv/gits-runtime/.venv/bin/python -m gits.cli \
    --db /var/lib/gits/shared/gits.db ghost \
    --node cloud

# 隔离三层：文件权限 / InaccessiblePaths / 非 root。
# 实例跑的是 /srv/gits-runtime 里的一份代码拷贝，不需要仓库。
InaccessiblePaths=/srv/gits
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# 共享库和它自己的私有目录；**别的实例的私有目录不在列表里**
ReadWritePaths=/var/lib/gits/shared /var/lib/gits/her

MemoryMax=200M
Nice=5

[Install]
WantedBy=multi-user.target
