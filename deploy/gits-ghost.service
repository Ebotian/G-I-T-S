[Unit]
Description=G-I-T-S 内核（心跳 / 回复 / 快照）
Documentation=file:/srv/gits/docs/research/ecs.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
Restart=always
RestartSec=2

WorkingDirectory=/srv/gits
# 密钥只在这一个文件里，0600，不进 git
EnvironmentFile=/etc/gits.env
ExecStart=/srv/gits/.venv/bin/python -m gits.cli \
    --db /srv/gits/var/gits.db ghost \
    --node cloud --persona /srv/gits/var/persona.md

MemoryMax=200M
Nice=5

[Install]
WantedBy=multi-user.target
